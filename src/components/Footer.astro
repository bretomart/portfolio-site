---
const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-stone-200 bg-white py-10 mt-16">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
      <div class="space-y-1">
        <p class="text-sm font-semibold text-stone-900 font-serif">
          Academic Portfolio: Scholarly Works Repository
        </p>
        <p class="text-xs text-stone-600 leading-relaxed max-w-md">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row sm:items-center gap-4 text-xs text-stone-500">
        <span>Static Astro Architecture</span>
        <span class="hidden sm:inline" aria-hidden="true">•</span>
        <span>Zero-JavaScript Default</span>
        <span class="hidden sm:inline" aria-hidden="true">•</span>
        <span>{currentYear}</span>
      </div>
    </div>
  </div>
</footer>
