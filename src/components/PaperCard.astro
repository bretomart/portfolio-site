---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

interface Props {
  paper: CollectionEntry<'research'>;
  index: number;
}

const { paper, index } = Astro.props;
const {
  title,
  subtitle,
  category,
  executiveAbstract,
  thematicAreas,
  keyPoints,
  publicationYear,
  status,
  institution,
  courseOrContext,
} = paper.data;

const { Content } = await render(paper);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const abstractParagraphs = executiveAbstract.split('\n\n').filter(Boolean);
const anchorId = `paper-${paper.id}`;
---

<article id={anchorId} class="bg-white border border-stone-200 rounded-lg p-6 sm:p-8 shadow-xs hover:border-stone-400 transition-colors scroll-mt-24">
  <!-- Top Metadata Bar -->
  <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
    <div class="flex flex-wrap items-center gap-2">
      <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-semibold bg-stone-900 text-stone-50">
        {category}
      </span>
      <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-medium border border-stone-300 text-stone-700 bg-stone-100">
        {publicationYear}
      </span>
      <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-medium border border-stone-300 text-stone-700 bg-stone-100">
        {status}
      </span>
    </div>

    {institution && (
      <span class="text-xs font-mono text-stone-500">
        {institution}
      </span>
    )}
  </div>

  <!-- Title and Subtitle -->
  <h2 class="text-xl sm:text-2xl font-serif font-bold text-stone-950 tracking-tight leading-snug mb-2">
    <a href={`${base}/research/${paper.id}`} class="hover:text-stone-700 transition-colors">
      {title}
    </a>
  </h2>

  {subtitle && (
    <p class="text-sm sm:text-base font-serif italic text-stone-700 mb-4">
      {subtitle}
    </p>
  )}

  {courseOrContext && (
    <p class="text-xs font-mono text-stone-600 mb-4">
      Context: {courseOrContext}
    </p>
  )}

  <!-- Thematic Tags -->
  <div class="flex flex-wrap gap-1.5 mb-6">
    {thematicAreas.map((area) => (
      <span class="text-xs px-2 py-0.5 rounded bg-stone-100 text-stone-800 font-medium border border-stone-200">
        {area}
      </span>
    ))}
  </div>

  <!-- Executive Academic Abstract in Cohesive Paragraphs -->
  <div class="space-y-4 mb-6">
    <div class="border-l-3 border-stone-900 pl-4 py-1 bg-stone-50/50 rounded-r">
      <h3 class="text-xs font-bold uppercase tracking-wider text-stone-900 mb-2 font-mono">
        Executive Academic Abstract
      </h3>
      <div class="space-y-3 text-xs sm:text-sm text-stone-800 leading-relaxed text-justify">
        {abstractParagraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </div>
  </div>

  <!-- Key Contributions & Navigable Bullet Points -->
  <div class="pt-4 border-t border-stone-200 mb-6 space-y-2">
    <h3 class="text-xs font-bold uppercase tracking-wider text-stone-900 font-mono">
      Core Analytical Contributions & Findings
    </h3>
    <ul class="space-y-1.5 text-xs text-stone-700">
      {keyPoints.map((point) => (
        <li class="flex items-start gap-2">
          <span class="text-stone-900 font-bold select-none">•</span>
          <span class="leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Full Text Excerpt Embed & Dedicated Reader View -->
  <div class="pt-4 border-t border-stone-200 space-y-4">
    <details class="group border border-stone-200 rounded-md bg-stone-50 overflow-hidden">
      <summary class="cursor-pointer px-4 py-2.5 text-xs font-mono font-semibold text-stone-800 hover:text-stone-950 flex items-center justify-between select-none bg-stone-100">
        <span class="flex items-center gap-2">
          <span class="text-stone-500 group-open:rotate-90 transition-transform">▶</span>
          <span>Embedded Excerpt: View Complete Document Body</span>
        </span>
        <span class="text-stone-500 font-normal">Expand inline embed</span>
      </summary>

      <div class="p-6 bg-white max-h-96 overflow-y-auto border-t border-stone-200">
        <div class="prose prose-stone prose-xs max-w-none text-stone-800 leading-relaxed font-sans prose-headings:font-serif prose-headings:text-stone-950 prose-h2:text-base prose-h2:border-b prose-h2:border-stone-200 prose-h2:pb-1 prose-h3:text-sm prose-strong:text-stone-950">
          <Content />
        </div>
      </div>
    </details>

    <div class="flex items-center justify-between pt-1">
      <a
        href={`${base}/research/${paper.id}`}
        class="inline-flex items-center justify-center px-4 py-2 rounded text-xs font-semibold text-white bg-stone-900 hover:bg-stone-800 transition-colors shadow-xs group"
      >
        <span>Open Dedicated Full-Text Reader View</span>
        <span class="ml-1.5 font-mono group-hover:translate-x-0.5 transition-transform" aria-hidden="true">→</span>
      </a>

      <span class="text-xs text-stone-500 font-mono">
        Full APA Citations Available
      </span>
    </div>
  </div>
</article>
