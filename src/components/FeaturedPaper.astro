---
import type { CollectionEntry } from 'astro:content';

interface Props {
  paper: CollectionEntry<'research'>;
}

const { paper } = Astro.props;
const {
  title,
  subtitle,
  executiveAbstract,
  thematicAreas,
  theoreticalFramework,
  empiricalCases,
  publicationYear,
  status
} = paper.data;

// Split executive abstract into distinct paragraphs
const abstractParagraphs = executiveAbstract.split('\n\n').filter(Boolean);
---

<article class="bg-white border border-stone-200 rounded-lg p-6 sm:p-8 shadow-xs hover:border-stone-400 transition-colors">
  <div class="flex flex-wrap items-center gap-2 mb-4">
    <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-semibold bg-stone-900 text-stone-50">
      Featured Working Paper
    </span>
    <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-medium border border-stone-300 text-stone-700 bg-stone-100">
      {publicationYear}
    </span>
    <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-medium border border-stone-300 text-stone-700 bg-stone-100">
      {status}
    </span>
  </div>

  <h2 class="text-2xl sm:text-3xl font-serif font-bold text-stone-950 tracking-tight leading-tight mb-2">
    <a href={`/research/${paper.id}`} class="hover:text-stone-700 transition-colors">
      {title}
    </a>
  </h2>

  <p class="text-base sm:text-lg font-serif italic text-stone-700 mb-6">
    {subtitle}
  </p>

  <div class="flex flex-wrap gap-1.5 mb-6">
    {thematicAreas.map((area) => (
      <span class="text-xs px-2 py-1 rounded bg-stone-100 text-stone-800 font-medium border border-stone-200">
        {area}
      </span>
    ))}
  </div>

  <div class="space-y-4 mb-8">
    <div class="border-l-3 border-stone-900 pl-4 py-1">
      <h3 class="text-xs font-bold uppercase tracking-wider text-stone-900 mb-2 font-mono">
        Executive Academic Abstract
      </h3>
      <div class="space-y-3 text-sm text-stone-800 leading-relaxed text-justify">
        {abstractParagraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-6 border-t border-stone-200 mb-8 text-xs">
    <div class="space-y-2">
      <h4 class="font-mono uppercase font-bold text-stone-900 tracking-wider">
        Theoretical Framework
      </h4>
      <ul class="space-y-1.5 text-stone-700">
        {theoreticalFramework.map((item) => (
          <li class="flex items-start gap-1.5">
            <span class="text-stone-900 font-semibold">{item.concept}:</span>
            <span class="text-stone-600">{item.scholar}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="space-y-2">
      <h4 class="font-mono uppercase font-bold text-stone-900 tracking-wider">
        Empirical Core Cases
      </h4>
      <div class="space-y-1.5 text-stone-700">
        <p>
          <strong class="text-stone-900">Primary:</strong> CMMA antitrafficking agency fieldwork (Aruba)
        </p>
        <p>
          <strong class="text-stone-900">Comparative:</strong> Senbis polymer consortium (Netherlands)
        </p>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-between pt-2">
    <a
      href={`/research/${paper.id}`}
      class="inline-flex items-center justify-center px-5 py-2.5 rounded text-sm font-semibold text-white bg-stone-900 hover:bg-stone-800 transition-colors shadow-xs group"
    >
      <span>Read Full Paper & Framework</span>
      <span class="ml-2 font-mono group-hover:translate-x-1 transition-transform" aria-hidden="true">→</span>
    </a>

    <span class="text-xs text-stone-500 font-mono">
      Complete text and APA references
    </span>
  </div>
</article>
