---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedPaper from '../components/FeaturedPaper.astro';
import { getCollection } from 'astro:content';

const papers = await getCollection('research');
const featuredPaper = papers[0];
---

<BaseLayout
  title="Academic Portfolio | Migration Governance & European Studies"
  description="Academic research portfolio examining postcolonial governance, migration frameworks, and institutional precarity within the Dutch Caribbean and the European Union."
  activeNav="research"
>
  <div class="space-y-12">
    <section class="border-b border-stone-200 pb-10">
      <div class="max-w-3xl space-y-4">
        <div class="inline-block px-2.5 py-1 rounded bg-stone-200 text-stone-800 text-xs font-mono font-semibold uppercase tracking-wider">
          Scholarly Focus & Architecture
        </div>
        <h1 class="text-3xl sm:text-4xl font-serif font-bold text-stone-950 tracking-tight leading-tight">
          Migration Governance, Constitutional Architecture, and Institutional Precarity
        </h1>
        <p class="text-base sm:text-lg text-stone-700 leading-relaxed font-serif">
          This static academic repository documents ongoing research situated at the intersection of International Affairs, European Studies, and Public Administration. The current phase establishes the static publishing infrastructure through an initial empirical investigation into Caribbean migration governance.
        </p>
        <p class="text-sm text-stone-600 leading-relaxed">
          The analytical core examines how institutional frameworks tasked with addressing vulnerable migrant populations experience systemic destabilization through political priority-setting rather than absolute fiscal scarcity. Grounded in primary fieldwork across the Dutch Caribbean, the work integrates critical border theory and postcolonial legal analysis to interrogate the mechanisms governing European Union Overseas Countries and Territories.
        </p>
      </div>
    </section>

    <section class="space-y-6">
      <div class="flex items-baseline justify-between">
        <div>
          <h2 class="text-xs font-bold uppercase tracking-wider text-stone-500 font-mono">
            Featured Empirical Investigation
          </h2>
          <p class="text-lg font-serif font-bold text-stone-900 mt-0.5">
            Primary Case Study & Theoretical Framework
          </p>
        </div>
      </div>

      {featuredPaper ? (
        <FeaturedPaper paper={featuredPaper} />
      ) : (
        <div class="p-8 border border-stone-200 rounded-lg bg-white text-stone-600 text-sm">
          No research paper collection entries found.
        </div>
      )}
    </section>
  </div>
</BaseLayout>
