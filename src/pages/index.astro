---
import BaseLayout from '../layouts/BaseLayout.astro';
import PaperCard from '../components/PaperCard.astro';
import { getCollection } from 'astro:content';

const allPapers = await getCollection('research');
// Sort papers by explicit order
allPapers.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const categories = Array.from(new Set(allPapers.map((p) => p.data.category)));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="Brandon Wong | Academic Research & Papers"
  description="Academic research portfolio of Brandon Wong, covering migration governance, European Union policy, climate diplomacy, and historical memory."
  activeNav="research"
>
  <div class="space-y-12">
    <!-- Scholar Overview Section -->
    <section class="border-b border-stone-200 pb-10 space-y-4">
      <div class="inline-block px-2.5 py-1 rounded bg-stone-200 text-stone-800 text-xs font-mono font-semibold uppercase tracking-wider">
        Academic Portfolio & Scholarly Works
      </div>

      <h1 class="text-3xl sm:text-4xl font-serif font-bold text-stone-950 tracking-tight leading-tight">
        Brandon Wong
      </h1>

      <p class="text-base sm:text-lg text-stone-700 font-serif italic">
        European Studies & Public Administration Scholar | Enterprise Hosting Systems Specialist
      </p>

      <div class="space-y-3 text-sm text-stone-800 leading-relaxed text-justify max-w-3xl">
        <p>
          This repository presents academic research papers, diplomatic negotiation analyses, and historical inquiries authored by Brandon Wong at NHL Stenden University of Applied Sciences. The corpus interrogates the operational realities of governance across European, Caribbean, and multilateral jurisdictions.
        </p>
        <p>
          Specific research thrusts examine how political priority-setting destabilizes frontline humanitarian infrastructures in the Dutch Caribbean, the legal mechanics of European Union migration externalization under Council Document 10363/26, the diplomatic bargaining dynamics of the European Green Deal, and the critical analysis of historical memory and ideological structures.
        </p>
      </div>

      <div class="pt-2 flex flex-wrap gap-4 text-xs font-mono text-stone-600">
        <span>Affiliation: NHL Stenden</span>
        <span>•</span>
        <span>Location: Leeuwarden, Netherlands</span>
        <span>•</span>
        <a href={`${base}/cv`} class="text-stone-900 underline hover:text-stone-700">
          Curriculum Vitae Overview →
        </a>
      </div>
    </section>

    <!-- Quick Sorting & Bullet Navigation Section -->
    <section class="bg-white border border-stone-200 rounded-lg p-6 space-y-5">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-b border-stone-200 pb-3">
        <div>
          <h2 class="text-xs font-bold uppercase tracking-wider text-stone-900 font-mono">
            Navigation Index & Sorting Matrix
          </h2>
          <p class="text-xs text-stone-500 font-serif mt-0.5">
            Select an academic domain or jump directly to authored papers and embedded excerpts.
          </p>
        </div>

        <span class="text-xs font-mono text-stone-500">
          {allPapers.length} Authored Works Available
        </span>
      </div>

      <!-- Domain Category Quick Filters -->
      <div class="flex flex-wrap gap-2">
        <a
          href="#all-papers"
          class="px-2.5 py-1 rounded text-xs font-medium bg-stone-900 text-white hover:bg-stone-800 transition-colors"
        >
          All Papers ({allPapers.length})
        </a>
        {categories.map((cat) => (
          <a
            href={`#category-${cat.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
            class="px-2.5 py-1 rounded text-xs font-medium bg-stone-100 text-stone-700 border border-stone-300 hover:bg-stone-200 hover:text-stone-950 transition-colors"
          >
            {cat}
          </a>
        ))}
      </div>

      <!-- Bullet Point Navigation List for Quick Sorting -->
      <div class="pt-2 space-y-2">
        <h3 class="text-xxs font-mono uppercase font-bold text-stone-500 tracking-wider">
          Quick Navigation by Paper Highlights:
        </h3>
        <ul class="space-y-2 text-xs text-stone-700">
          {allPapers.map((paper, idx) => (
            <li class="flex items-start gap-2 hover:text-stone-950">
              <span class="text-stone-900 font-bold select-none font-mono">[{idx + 1}]</span>
              <div class="flex-grow flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                <a
                  href={`#paper-${paper.id}`}
                  class="font-serif font-bold text-stone-900 hover:underline"
                >
                  {paper.data.title}
                </a>
                <span class="text-xxs font-mono text-stone-500 whitespace-nowrap">
                  {paper.data.category} ({paper.data.publicationYear})
                </span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Papers List Section -->
    <section id="all-papers" class="space-y-10">
      <div class="border-b border-stone-200 pb-2">
        <h2 class="text-xs font-bold uppercase tracking-wider text-stone-500 font-mono">
          Scholarly Papers & Detailed Excerpts
        </h2>
        <p class="text-xl font-serif font-bold text-stone-950 mt-1">
          Complete Research Papers, Position Briefs & Theoretical Works
        </p>
      </div>

      <div class="space-y-12">
        {allPapers.map((paper, index) => {
          const categorySlug = `category-${paper.data.category.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
          return (
            <div id={categorySlug} class="space-y-3">
              <PaperCard paper={paper} index={index} />
            </div>
          );
        })}
      </div>
    </section>
  </div>
</BaseLayout>
