---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const education = [
  {
    institution: 'NHL Stenden University of Applied Sciences',
    degree: 'Bachelor of Arts (BA), European Studies',
    period: 'September 2023 - August 2027',
    location: 'Leeuwarden, Friesland, Netherlands',
    details: 'Specialization in European integration, global perspectives, migration policy, and EU foreign relations.'
  },
  {
    institution: 'NHL Stenden University of Applied Sciences',
    degree: 'Bachelor of Arts (BA), Public Administration',
    period: 'September 2020 - August 2023',
    location: 'Leeuwarden, Friesland, Netherlands',
    details: 'Focus on public governance, administrative law, institutional evaluation, and organizational theory.'
  },
  {
    institution: 'NHL Stenden University of Applied Sciences',
    degree: 'Bachelor of Arts (BA), Security and Safety Management',
    period: 'September 2019 - August 2020',
    location: 'Leeuwarden, Friesland, Netherlands',
    details: 'Foundational coursework in crisis management, systemic risk analysis, and public safety frameworks.'
  },
  {
    institution: 'University of Aruba',
    degree: 'Academic Foundation Year',
    period: 'February 2019 - August 2019',
    location: 'Oranjestad, Aruba',
    details: 'Rigorous academic preparatory program in social sciences, research methods, and legal studies.'
  },
  {
    institution: 'University of Aruba',
    degree: 'Bachelor of Arts (BA), Organization, Governance and Management',
    period: 'September 2018 - February 2019',
    location: 'Oranjestad, Aruba',
    details: 'Initial undergraduate studies in Caribbean public administration, organizational governance, and civic management.'
  }
];

const experience = [
  {
    role: 'Client Services Manager',
    company: 'Bearded Host PTY LTD',
    period: 'July 2025 - Present',
    location: 'Tasmania, Australia (Remote)',
    description: 'Manages enterprise client relationships, service delivery operations, and strategic technical partnerships across global cloud hosting environments. Directs service level agreement compliance and coordinates with engineering teams to resolve complex server and network incidents.'
  },
  {
    role: 'Systems Technician',
    company: 'ArmaHosts',
    period: 'November 2022 - June 2025',
    location: 'Oregon, United States (Remote)',
    description: 'Maintained and deployed high-performance dedicated servers and distributed game server instances. Diagnosed operating system performance bottlenecks, administered Linux environments, and configured secure server management interfaces.'
  },
  {
    role: 'Technical Support Agent',
    company: 'DedicatedMC, LLC',
    period: 'January 2021 - June 2025',
    location: 'Richmond, Virginia, United States (Remote)',
    description: 'Delivered technical assistance for enterprise hosting clients, specializing in server virtualization, network optimization, and client service relations over a four-year tenure.'
  }
];

const competencies = [
  {
    area: 'European Studies & Governance',
    items: [
      'European Union institutions, decision-making procedures, and legislative harmonization',
      'Overseas Countries and Territories (OCT) constitutional frameworks and Kingdom Charter law',
      'Multilateral climate diplomacy, Council negotiation strategies, and Green Deal policy',
      'Border externalization, asylum governance, and human rights monitoring'
    ]
  },
  {
    area: 'Public Administration & Research',
    items: [
      'Primary fieldwork methodology, expert interviews, and 7S organizational evaluations',
      'Policy analysis, institutional precarity assessments, and public budgeting audits',
      'Institutional research into postcolonial governance frameworks and human rights',
      'Formal academic writing, APA documentation, and policy brief drafting'
    ]
  },
  {
    area: 'Technical Systems & Server Infrastructure',
    items: [
      'Linux server administration, command-line operations, and service management',
      'Dedicated server hosting architecture, cloud virtualization, and uptime monitoring',
      'Static web generation with Astro, Tailwind CSS, and zero-runtime client architectures',
      'Enterprise client services management, SLA governance, and stakeholder relations'
    ]
  }
];
---

<BaseLayout
  title="Curriculum Vitae | Brandon Wong"
  description="Formal curriculum vitae of Brandon Wong, detailing academic education at NHL Stenden and University of Aruba, and professional experience in server infrastructure."
  activeNav="cv"
>
  <div class="max-w-3xl mx-auto space-y-12">
    <!-- Header Section -->
    <header class="border-b border-stone-200 pb-8 space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-4">
        <div>
          <h1 class="text-3xl sm:text-4xl font-serif font-bold text-stone-950 tracking-tight">
            Brandon Wong
          </h1>
          <p class="text-base sm:text-lg text-stone-700 font-serif italic mt-1">
            European Studies & Public Administration Scholar | Enterprise Server & Client Services Manager
          </p>
          <p class="text-xs text-stone-500 font-mono mt-1">
            Leeuwarden, Friesland, Netherlands
          </p>
        </div>

        <div class="flex flex-col sm:items-end gap-1.5 text-xs font-mono">
          <a
            href="mailto:brandon@bretom.art"
            class="text-stone-700 hover:text-stone-950 transition-colors"
          >
            brandon@bretom.art
          </a>
          <a
            href="https://www.linkedin.com/in/brandon-wong-652461340"
            target="_blank"
            rel="noopener noreferrer"
            class="text-stone-700 hover:text-stone-950 underline transition-colors"
          >
            LinkedIn Profile ↗
          </a>
        </div>
      </div>

      <div class="pt-4 border-t border-stone-100 text-sm text-stone-800 leading-relaxed text-justify space-y-3">
        <p>
          Brandon Wong is an academic researcher and technical operations professional pursuing advanced studies in European Studies at NHL Stenden University of Applied Sciences, having completed prior qualifications in Public Administration and Security Management. His scholarly research investigates migration governance, postcolonial constitutional asymmetries within the Kingdom of the Netherlands, and European Union geopolitical readiness.
        </p>
        <p>
          Parallel to his academic appointments, he brings more than four years of enterprise experience in the dedicated server hosting industry, managing client operations, strategic partner relations, and Linux server environments. This dual background unites rigorous analytical policy evaluation with pragmatic systems administration.
        </p>
      </div>
    </header>

    <!-- Education Section -->
    <section class="space-y-6">
      <div class="flex items-center justify-between border-b border-stone-200 pb-2">
        <h2 class="text-xs font-bold uppercase tracking-wider text-stone-900 font-mono">
          Academic Education
        </h2>
        <span class="text-xs text-stone-500 font-mono">Higher Education & Degrees</span>
      </div>

      <div class="space-y-6">
        {education.map((item) => (
          <div class="border-l-2 border-stone-300 pl-4 py-0.5 space-y-1">
            <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
              <h3 class="text-base font-serif font-bold text-stone-950">
                {item.degree}
              </h3>
              <span class="text-xs font-mono text-stone-500">
                {item.period}
              </span>
            </div>
            <p class="text-sm font-medium text-stone-700">
              {item.institution} <span class="text-xs text-stone-500 font-sans">({item.location})</span>
            </p>
            <p class="text-xs text-stone-600 leading-relaxed pt-0.5">
              {item.details}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Professional Experience Section -->
    <section class="space-y-6">
      <div class="flex items-center justify-between border-b border-stone-200 pb-2">
        <h2 class="text-xs font-bold uppercase tracking-wider text-stone-900 font-mono">
          Professional Experience
        </h2>
        <span class="text-xs text-stone-500 font-mono">Hosting Industry & Technical Operations</span>
      </div>

      <div class="space-y-6">
        {experience.map((item) => (
          <div class="border-l-2 border-stone-900 pl-4 py-0.5 space-y-1.5">
            <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
              <h3 class="text-base font-serif font-bold text-stone-950">
                {item.role}
              </h3>
              <span class="text-xs font-mono text-stone-500">
                {item.period}
              </span>
            </div>
            <p class="text-sm font-semibold text-stone-800">
              {item.company} <span class="text-xs text-stone-500 font-sans font-normal">({item.location})</span>
            </p>
            <p class="text-xs text-stone-700 leading-relaxed">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Core Competencies with Navigable Bullet Points -->
    <section class="space-y-6">
      <div class="flex items-center justify-between border-b border-stone-200 pb-2">
        <h2 class="text-xs font-bold uppercase tracking-wider text-stone-900 font-mono">
          Core Competencies & Capabilities
        </h2>
        <span class="text-xs text-stone-500 font-mono">Detailed Skill Categorization</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {competencies.map((comp) => (
          <div class="bg-white border border-stone-200 rounded-lg p-5 space-y-3">
            <h3 class="font-serif font-bold text-stone-900 text-sm border-b border-stone-100 pb-2">
              {comp.area}
            </h3>
            <ul class="space-y-2 text-xs text-stone-700">
              {comp.items.map((bullet) => (

        <li class="p-3 bg-white border border-stone-200 rounded flex flex-col sm:flex-row sm:items-center justify-between gap-2 hover:border-stone-400 transition-colors">
          <div>
            <a href={`${base}/research/memory-ideological-structures-poetics`} class="font-serif font-bold text-stone-900 hover:underline">
              Multiple Imaginations: Memory, Ideological Structures, and Historical Rupture
            </a>
            <p class="text-stone-600 mt-0.5">Fritz Stern, Moishe Postone, and original historical poem 'Dormant' (2025)</p>
          </div>
          <span class="px-2 py-0.5 rounded bg-stone-100 text-stone-700 font-mono uppercase text-xxs">Political Theory</span>
        </li>
      </ul>
    </section>

    <!-- Navigation Back -->
    <div class="pt-6 border-t border-stone-200 flex justify-between items-center text-xs text-stone-600">
      <a href={`${base}/`} class="hover:text-stone-950 font-mono transition-colors">
        ← Return to Research & Papers Overview
      </a>
      <span class="font-mono">Curriculum Vitae Updated October 2026</span>
    </div>
  </div>
</BaseLayout>
