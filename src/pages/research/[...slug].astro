---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const papers = await getCollection('research');
  return papers.map((paper) => ({
    params: { slug: paper.id },
    props: { paper },
  }));
}

const { paper } = Astro.props;
const { Content, headings } = await render(paper);
const {
  title,
  subtitle,
  author,
  category,
  executiveAbstract,
  thematicAreas,
  keyPoints,
  theoreticalFramework,
  empiricalCases,
  apaReferences,
  publicationYear,
  status,
  institution,
  courseOrContext,
} = paper.data;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const abstractParagraphs = executiveAbstract.split('\n\n').filter(Boolean);

// Filter headings for document navigation (depth 2 and 3)
const navHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout
  title={`${title} | Brandon Wong`}
  description={subtitle || title}
  activeNav="research"
  maxWidth="max-w-6xl"
>
  <div class="space-y-8">
    <!-- Breadcrumb & Top Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-stone-200 pb-4">
      <nav aria-label="Breadcrumb">
        <a
          href={`${base}/`}
          class="inline-flex items-center text-xs font-mono font-semibold text-stone-600 hover:text-stone-950 transition-colors group"
        >
          <span class="mr-1.5 group-hover:-translate-x-1 transition-transform" aria-hidden="true">←</span>
          <span>Back to Research & Papers Overview</span>
        </a>
      </nav>

      <div class="flex items-center gap-2 text-xs font-mono text-stone-500">
        <span>Full-Text Academic Reader</span>
        <span>•</span>
        <span>{publicationYear}</span>
      </div>
    </div>

    <!-- Paper Header Banner -->
    <header class="space-y-4 border-b border-stone-200 pb-8">
      <div class="flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-semibold bg-stone-900 text-stone-50">
          {category}
        </span>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-medium border border-stone-300 text-stone-700 bg-stone-100">
          {status}
        </span>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-medium border border-stone-300 text-stone-700 bg-stone-100">
          Publication Year: {publicationYear}
        </span>
      </div>

      <h1 class="text-2xl sm:text-4xl font-serif font-bold text-stone-950 tracking-tight leading-tight">
        {title}
      </h1>

      {subtitle && (
        <p class="text-lg sm:text-xl font-serif italic text-stone-700">
          {subtitle}
        </p>
      )}

      <div class="pt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs font-mono text-stone-600 border-t border-stone-100">
        <span>Author: {author}</span>
        {institution && (
          <>
            <span>•</span>
            <span>{institution}</span>
          </>
        )}
        {courseOrContext && (
          <>
            <span>•</span>
            <span>{courseOrContext}</span>
          </>
        )}
      </div>

      <div class="flex flex-wrap gap-1.5 pt-2">
        {thematicAreas.map((area) => (
          <span class="text-xs px-2.5 py-1 rounded bg-stone-100 text-stone-800 font-medium border border-stone-200">
            {area}
          </span>
        ))}
      </div>
    </header>

    <!-- Mobile Section Navigator (visible below lg) -->
    <div class="block lg:hidden">
      <details class="border border-stone-200 rounded-lg bg-white overflow-hidden">
        <summary class="cursor-pointer px-4 py-3 text-xs font-mono font-bold text-stone-900 bg-stone-100 hover:bg-stone-200 transition-colors flex items-center justify-between select-none">
          <span class="flex items-center gap-2">
            <span>☰</span>
            <span>Full-Text Navigator: Quick Jump to Sections ({navHeadings.length})</span>
          </span>
          <span class="text-stone-500 font-normal">Tap to expand</span>
        </summary>
        <div class="p-4 space-y-2 text-xs font-mono max-h-80 overflow-y-auto">
          <a href="#executive-abstract" class="block text-stone-700 hover:text-stone-950 py-1 border-b border-stone-100">
            • Executive Abstract
          </a>
          <a href="#core-contributions" class="block text-stone-700 hover:text-stone-950 py-1 border-b border-stone-100">
            • Core Highlights & Contributions
          </a>
          {navHeadings.map((h) => (
            <a
              href={`#${h.slug}`}
              class:list={[
                'block py-1 hover:text-stone-950 transition-colors',
                h.depth === 2
                  ? 'font-medium text-stone-900 border-b border-stone-100'
                  : 'pl-3 text-stone-600'
              ]}
            >
              {h.depth === 2 ? '• ' : '- '}{h.text}
            </a>
          ))}
          {apaReferences && apaReferences.length > 0 && (
            <a href="#apa-bibliography" class="block text-stone-700 hover:text-stone-950 py-1 pt-2 font-medium">
              • Complete Bibliography (APA)
            </a>
          )}
        </div>
      </details>
    </div>

    <!-- Main Content & Desktop Navigator Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <!-- Article Content Column -->
      <div class="lg:col-span-8 space-y-10 min-w-0">
        <!-- Executive Abstract Box -->
        <section
          id="executive-abstract"
          aria-labelledby="executive-summary-heading"
          class="bg-stone-100 border border-stone-300 rounded-lg p-6 sm:p-8 space-y-4 scroll-mt-24"
        >
          <div class="flex items-center justify-between border-b border-stone-300 pb-3">
            <h2 id="executive-summary-heading" class="text-xs font-bold uppercase tracking-wider text-stone-900 font-mono">
              Executive Academic Abstract
            </h2>
            <span class="text-xs text-stone-600 font-mono">Scholarly Summary</span>
          </div>
          <div class="space-y-3 text-sm text-stone-800 leading-relaxed text-justify">
            {abstractParagraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </section>

        <!-- Core Highlights Box -->
        <section
          id="core-contributions"
          class="bg-white border border-stone-200 rounded-lg p-6 space-y-3 scroll-mt-24"
        >
          <h2 class="text-xs font-mono uppercase font-bold text-stone-900 tracking-wider">
            Core Analytical Contributions & Highlights
          </h2>
          <ul class="space-y-2 text-xs text-stone-700">
            {keyPoints.map((point) => (
              <li class="flex items-start gap-2">
                <span class="text-stone-900 font-bold select-none">•</span>
                <span class="leading-relaxed">{point}</span>
              </li>
            ))}
          </ul>
        </section>

        <!-- Optional Empirical & Theoretical Scope -->
        {(theoreticalFramework || empiricalCases) && (
          <section
            id="investigation-scope"
            class="grid grid-cols-1 sm:grid-cols-2 gap-6 bg-white border border-stone-200 rounded-lg p-6 text-xs scroll-mt-24"
          >
            {theoreticalFramework && (
              <div class="space-y-3">
                <h3 class="font-mono uppercase font-bold text-stone-900 tracking-wider">
                  Theoretical Lenses
                </h3>
                <ul class="space-y-2 text-stone-700">
                  {theoreticalFramework.map((item: any) => (
                    <li class="border-l-2 border-stone-400 pl-2.5">
                      <span class="font-bold text-stone-900 block">{item.concept}</span>
                      <span class="text-stone-600 block">{item.scholar}</span>
                      <span class="text-stone-700 text-xs block mt-0.5 leading-normal">{item.description}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {empiricalCases && (
              <div class="space-y-3">
                <h3 class="font-mono uppercase font-bold text-stone-900 tracking-wider">
                  Empirical Investigation Scope
                </h3>
                <div class="space-y-3 text-stone-700 leading-relaxed">
                  {empiricalCases.primary && (
                    <div class="border-l-2 border-stone-400 pl-2.5">
                      <span class="font-bold text-stone-900 block">Primary Fieldwork:</span>
                      <span>{empiricalCases.primary}</span>
                    </div>
                  )}
                  {empiricalCases.structural && (
                    <div class="border-l-2 border-stone-400 pl-2.5">
                      <span class="font-bold text-stone-900 block">Constitutional Scope:</span>
                      <span>{empiricalCases.structural}</span>
                    </div>
                  )}
                  {empiricalCases.comparative && (
                    <div class="border-l-2 border-stone-400 pl-2.5">
                      <span class="font-bold text-stone-900 block">Comparative Illustration:</span>
                      <span>{empiricalCases.comparative}</span>
                    </div>
                  )}
                </div>
              </div>
            )}
          </section>
        )}

        <!-- Full Paper Document Body -->
        <div class="border-t border-stone-200 pt-8">
          <div class="prose prose-stone max-w-none text-stone-800 leading-relaxed font-sans prose-headings:font-serif prose-headings:text-stone-950 prose-h2:text-2xl prose-h2:border-b prose-h2:border-stone-200 prose-h2:pb-2 prose-h2:mt-10 prose-h3:text-lg prose-strong:text-stone-950 prose-blockquote:border-l-stone-400 prose-blockquote:font-serif prose-blockquote:italic">
            <Content />
          </div>
        </div>

        <!-- Complete Bibliography (if available) -->
        {apaReferences && apaReferences.length > 0 && (
          <section
            id="apa-bibliography"
            aria-labelledby="apa-bibliography-heading"
            class="border-t-2 border-stone-900 pt-8 mt-12 space-y-6 scroll-mt-24"
          >
            <div class="space-y-1">
              <h2 id="apa-bibliography-heading" class="text-xl font-serif font-bold text-stone-950">
                Complete Bibliography (APA Format)
              </h2>
              <p class="text-xs text-stone-600 font-mono">
                Formal academic citations formatted according to the American Psychological Association (APA) standard.
              </p>
            </div>

            <div class="space-y-4 pt-2">
              {apaReferences.map((ref: string) => (
                <div class="pl-8 -indent-8 text-sm leading-relaxed text-stone-800 font-serif">
                  {ref}
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Bottom Navigation -->
        <div class="pt-8 border-t border-stone-200 flex justify-between items-center text-xs text-stone-600">
          <a href={`${base}/`} class="hover:text-stone-950 font-mono transition-colors">
            ← Return to Research & Papers Overview
          </a>
          <span class="font-mono">End of Academic Text</span>
        </div>
      </div>

      <!-- Desktop Sticky Section Navigator Sidebar -->
      <aside class="hidden lg:block lg:col-span-4 sticky top-20">
        <div class="bg-white border border-stone-200 rounded-lg p-5 space-y-4 shadow-xs max-h-[calc(100vh-6rem)] overflow-y-auto">
          <div class="border-b border-stone-200 pb-2">
            <h2 class="text-xs font-bold uppercase tracking-wider text-stone-900 font-mono">
              Section Navigator
            </h2>
            <p class="text-xxs text-stone-500 font-serif mt-0.5">
              Quick jumping within full-text view
            </p>
          </div>

          <!-- General Sections -->
          <div class="space-y-1 text-xs font-mono">
            <a
              href="#executive-abstract"
              class="block px-2 py-1 rounded text-stone-700 hover:text-stone-950 hover:bg-stone-100 transition-colors"
            >
              • Executive Abstract
            </a>
            <a
              href="#core-contributions"
              class="block px-2 py-1 rounded text-stone-700 hover:text-stone-950 hover:bg-stone-100 transition-colors"
            >
              • Core Highlights
            </a>
            {(theoreticalFramework || empiricalCases) && (
              <a
                href="#investigation-scope"
                class="block px-2 py-1 rounded text-stone-700 hover:text-stone-950 hover:bg-stone-100 transition-colors"
              >
                • Empirical Scope
              </a>
            )}
          </div>

          <!-- Document Headings -->
          {navHeadings.length > 0 && (
            <div class="pt-3 border-t border-stone-100 space-y-1">
              <h3 class="text-xxs font-mono uppercase font-bold text-stone-400 tracking-wider px-2">
                Document Sections:
              </h3>
              <nav aria-label="Table of Contents">
                <ul class="space-y-0.5 text-xs">
                  {navHeadings.map((h) => (
                    <li>
                      <a
                        href={`#${h.slug}`}
                        class:list={[
                          'block px-2 py-1 rounded transition-colors',
                          h.depth === 2
                            ? 'font-medium text-stone-900 hover:text-stone-950 hover:bg-stone-100'
                            : 'pl-5 text-stone-600 hover:text-stone-950 hover:bg-stone-50 text-xxs'
                        ]}
                      >
                        {h.depth === 2 ? '• ' : '- '}{h.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </div>
          )}

          {apaReferences && apaReferences.length > 0 && (
            <div class="pt-3 border-t border-stone-100">
              <a
                href="#apa-bibliography"
                class="block px-2 py-1 rounded text-xs font-mono font-medium text-stone-800 hover:text-stone-950 hover:bg-stone-100 transition-colors"
              >
                • APA Bibliography
              </a>
            </div>
          )}

          <div class="pt-3 border-t border-stone-200 flex justify-between items-center text-xxs font-mono text-stone-500">
            <a href="#main-content" class="hover:text-stone-950 underline">
              ↑ Back to top
            </a>
            <span>{navHeadings.length} sections</span>
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
